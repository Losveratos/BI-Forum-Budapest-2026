/// v3 report rows for Core matrices: the L1 items of the income statement (RowType
/// account) plus the subtotals Gross profit, EBITDA, EBIT, EBT, Net
/// income (formula rows of dim-konten) in statement order. No relationship;
/// the measures in the folder "Budapest demo\Statement" read the row via
/// SELECTEDVALUE. A subtotal sums all L1 items with
/// 'L1 Sort' < 'Upto Sort'.
table pnl-lines
	lineageTag: 530da059-01fc-4af7-9658-fdfa798b5f39

	/// Row label, equal to 'dim-konten'[L1 EN].
	column Line
		dataType: string
		lineageTag: 6a93219b-efae-49c0-b9f6-abd4c0bc4de2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Line]
		sortByColumn: 'Line Sort'

		annotation SummarizationSetBy = Automatic

	/// Income statement order, equal to 'dim-konten'[L1 Sort].
	column 'Line Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c63451b6-f04d-4881-9f6f-2fab68d5a097
		summarizeBy: none
		isNameInferred
		sourceColumn: [Line Sort]

		annotation SummarizationSetBy = Automatic

	/// "line" for an L1 item, "subtotal" for a subtotal.
	column 'Line Type'
		dataType: string
		lineageTag: 40f84a93-7085-4a29-9d09-4d85af6401e1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Line Type]

		annotation SummarizationSetBy = Automatic

	/// Subtotal over all L1 items with 'L1 Sort' less than this
	/// value. For "line" equal to 'Line Sort'.
	column 'Upto Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 35fbb0fd-97dd-4da9-a30d-c958cb2b7368
		summarizeBy: none
		isNameInferred
		sourceColumn: [Upto Sort]

		annotation SummarizationSetBy = Automatic

	partition pnl-lines = calculated
		mode: import
		source =
				VAR _Rows =
				    FILTER (
				        SUMMARIZE (
				            'dim-konten',
				            'dim-konten'[L1 EN],
				            'dim-konten'[L1 Sort],
				            'dim-konten'[RowType],
				            'dim-konten'[Statement]
				        ),
				        'dim-konten'[Statement] = "Income statement"
				            && 'dim-konten'[RowType] IN { "account", "formula" }
				            && 'dim-konten'[L1 EN] <> ""
				    )
				RETURN
				    SELECTCOLUMNS (
				        _Rows,
				        "Line", 'dim-konten'[L1 EN],
				        "Line Sort", 'dim-konten'[L1 Sort],
				        "Line Type", IF ( 'dim-konten'[RowType] = "formula", "subtotal", "line" ),
				        "Upto Sort", 'dim-konten'[L1 Sort]
				    )

