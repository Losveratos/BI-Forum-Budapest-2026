/// Drei Regionen. Hängt an dim-gesellschaft, nicht direkt an den Fakten.
table dim-region
	lineageTag: 1e9edc10-a80f-42be-8b8a-ef556ac2968b

	/// Schlüssel zu dim-gesellschaft — ein Schneeflocken-Ast, Region
	/// filtert über die Gesellschaft auf die Fakten.
	column RegionID
		dataType: string
		lineageTag: bb6472e9-8303-44aa-8cfc-7c23e2f0739b
		summarizeBy: none
		sourceColumn: RegionID

		annotation SummarizationSetBy = Automatic

	column Region
		dataType: string
		lineageTag: 2ed8e5ed-a713-4ad8-80bb-bce7528f2cce
		summarizeBy: none
		sourceColumn: Region
		sortByColumn: Sortierung

		annotation SummarizationSetBy = Automatic

	column 'Region DE'
