	partition dim-region = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(DemoPfad & "dim-region.csv"), [Delimiter = ";", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Header, {{"RegionID", type text}, {"Region", type text}, {"Region DE", type text}, {"Region EN", type text}, {"Sortierung", Int64.Type}, {"Hauptsitz", type text}, {"Zeitzone", type text}, {"Gesellschaften", Int64.Type}}, "en-US")
				in
				    Typen

	annotation PBI_ResultType = Table

