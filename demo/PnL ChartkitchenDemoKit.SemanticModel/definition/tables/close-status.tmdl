/// v3 switch for the month-end close scene. With no selection (default) or with
/// "Closed WD3", AC stays exactly as before; "Incl. day-3 adjustment" adds
/// fact-nachbuchung. No relationship to other tables.
table close-status
	lineageTag: 31c80196-ea2b-4c22-96c3-5b303f3d36f2

	column 'Close status'
		dataType: string
		lineageTag: 731163fb-5cbb-4b65-8254-a795894adf8d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Close status]
		sortByColumn: 'Close status Sort'

		annotation SummarizationSetBy = Automatic

	column 'Close status Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 208f2e71-2c8f-495c-b4e9-af86439ae225
		summarizeBy: none
		isNameInferred
		sourceColumn: [Close status Sort]

		annotation SummarizationSetBy = Automatic

	partition close-status = calculated
		mode: import
		source =
				DATATABLE (
				    "Close status", STRING,
				    "Close status Sort", INTEGER,
				    {
				        { "Closed WD3", 1 },
				        { "Incl. day-3 adjustment", 2 }
				    }
				)

