/// Monthly FX rates per currency, in units of local currency per 1 EUR.
/// Average rate for income statement items and cash flows, closing rate
/// for balance sheet items (IAS 21). The translation has already been done in the
/// fact table; this table makes it traceable.
table fact-kurse
	lineageTag: 1073e1d2-0bd3-477f-8a60-be9cb2d8727a

	/// ISO code of the local currency.
	column Währung
		dataType: string
		lineageTag: 839a6642-a1ed-4e6e-8204-3179fc4245b1
		summarizeBy: none
		sourceColumn: Währung

		annotation SummarizationSetBy = Automatic

	/// Last day of the month, link to the date dimension.
	column Datum
		dataType: dateTime
		formatString: yyyy-mm-dd
		displayFolder: Periode
		lineageTag: 944d0271-433d-44b2-8220-8961bb2cc7e4
		summarizeBy: none
		sourceColumn: Datum

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Monat
		dataType: string
		displayFolder: Periode
		lineageTag: aa003a9b-f963-42eb-8b8a-919e1597b15e
		summarizeBy: none
		sourceColumn: Monat

		annotation SummarizationSetBy = Automatic

	column Jahr
		dataType: int64
		formatString: 0
		displayFolder: Periode
		lineageTag: eee29172-39cf-46b2-8678-f72fc0dc3d9f
		summarizeBy: none
		sourceColumn: Jahr

		annotation SummarizationSetBy = Automatic

	column Periode
		dataType: string
		displayFolder: Periode
		lineageTag: ad707c71-6d61-4ecb-880c-7f97b280a99d
		summarizeBy: none
		sourceColumn: Periode
		sortByColumn: PeriodeSort

		annotation SummarizationSetBy = Automatic

	column PeriodeSort
		dataType: int64
		formatString: 0
		displayFolder: Periode
		lineageTag: 2d315db6-99a9-46e9-83b0-2f52bd48fb8a
		summarizeBy: none
		sourceColumn: PeriodeSort

		annotation SummarizationSetBy = Automatic

	/// Average rate of the month, units of local currency per 1 EUR.
	/// For income statement items and cash flows.
	column 'Kurs Durchschnitt'
		dataType: double
		formatString: #,##0.0000
		lineageTag: 093647bb-14bf-4a22-8b5b-27c90f205ef4
		summarizeBy: none
		sourceColumn: Kurs Durchschnitt

		annotation SummarizationSetBy = Automatic

	/// Rate on the last day of the month, units of local currency per 1 EUR. For
	/// balance sheet items.
	column 'Kurs Stichtag'
		dataType: double
		formatString: #,##0.0000
		lineageTag: 3753f347-d430-4645-8f21-fb440cc67f68
		summarizeBy: none
		sourceColumn: Kurs Stichtag

		annotation SummarizationSetBy = Automatic

	/// Budget rate (v3), local currency per 1 EUR, fixed per currency and year:
	/// mean of the average rates Oct to Dec of the previous year, for 2025 the
	/// January average rate. EUR = 1. Basis for 'AC signed @BUD'.
	column 'Kurs Budget'
		dataType: double
		formatString: #,##0.0000
		lineageTag: 800e32cd-4c41-4c48-bd8c-4c0837c7c14e
		summarizeBy: none
		sourceColumn: Kurs Budget

		annotation SummarizationSetBy = Automatic

	partition fact-kurse = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(DemoPfad & "fact-kurse.csv"), [Delimiter = ";", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Header, {{"Währung", type text}, {"Datum", type date}, {"Monat", type text}, {"Jahr", Int64.Type}, {"Periode", type text}, {"PeriodeSort", Int64.Type}, {"Kurs Durchschnitt", type number}, {"Kurs Stichtag", type number}, {"Kurs Budget", type number}}, "en-US")
				in
				    Typen

	annotation PBI_ResultType = Table

