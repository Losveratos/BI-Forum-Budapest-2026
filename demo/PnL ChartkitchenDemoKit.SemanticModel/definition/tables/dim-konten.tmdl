		dataType: string
		displayFolder: Levels DE
		lineageTag: 50ef47d4-7a3c-4d22-8a8a-4d574c986324
		summarizeBy: none
		sourceColumn: L3

		annotation SummarizationSetBy = Automatic

	column L4
