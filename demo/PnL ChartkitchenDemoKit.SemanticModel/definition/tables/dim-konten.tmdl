/// Kontenplan für alle drei Rechenwerke. Die Spalte Abschluss wählt
/// zwischen GuV, Bilanz und Cashflow; L1 bis L6 tragen die Hierarchie in
/// Deutsch, L1 EN bis L6 EN dieselbe in Englisch.
table dim-konten
	lineageTag: 458ba298-e6a7-4032-8c24-e48d5c674a59

	/// Technischer Schlüssel. Präfix G = GuV, B = Bilanz, C = Cashflow, N =
	/// Knotenzeile für den Parent-Child-Modus.
	column AccountID
		dataType: string
		lineageTag: 5d159984-6390-483a-8d6f-d31733a7dcf6
		summarizeBy: none
		sourceColumn: AccountID

		annotation SummarizationSetBy = Automatic

	/// Nur für den Parent-Child-Modus. Im Levels-Modus NICHT binden, sonst
	/// ignoriert das Visual L1 bis L6.
	column ParentAccountID
		dataType: string
		displayFolder: Steuerung
		lineageTag: 3c26dc04-837b-4c03-8b00-0b6bb1ecc2f2
		summarizeBy: none
		sourceColumn: ParentAccountID

		annotation SummarizationSetBy = Automatic

	column Kontonummer
		dataType: string
		displayFolder: Steuerung
		lineageTag: a2a7c83f-8a3f-48c4-8232-d19897eb138a
		summarizeBy: none
		sourceColumn: Kontonummer

		annotation SummarizationSetBy = Automatic

	/// GuV, Bilanz oder Cashflow. Gehört auf einen Slicer — damit wählt man
	/// die Aufstellung aus.
	column Abschluss
		dataType: string
		lineageTag: a769aed3-30a3-42dc-8f5e-17e46e0f87cb
		summarizeBy: none
		sourceColumn: Abschluss

		annotation SummarizationSetBy = Automatic

	/// Englische Entsprechung zu Abschluss.
	column Statement
		dataType: string
		lineageTag: 42132b5b-0f8c-40f8-874c-3de1b7127449
		summarizeBy: none
		sourceColumn: Statement

		annotation SummarizationSetBy = Automatic

	/// Zeilenname, deutsch. Formeln in FormulaDef verweisen auf genau diese
	/// Namen.
	column Name
		dataType: string
		lineageTag: 3924498d-73ab-4f7e-8f9c-f0b939cf3d54
		summarizeBy: none
		sourceColumn: Name

		annotation SummarizationSetBy = Automatic

	/// Zeilenname, englisch. Passt zu FormulaDef EN.
	column 'Name EN'
		dataType: string
		lineageTag: 2d0e09da-f603-46cb-8dd5-2a60145fb909
		summarizeBy: none
		sourceColumn: Name EN

		annotation SummarizationSetBy = Automatic

