	column 'L5 EN'
		dataType: string
		displayFolder: Levels EN
		lineageTag: 989ef90c-5443-45dd-8fd5-428a46bdea0c
		summarizeBy: none
		sourceColumn: L5 EN

		annotation SummarizationSetBy = Automatic

	column 'L6 EN'
		dataType: string
		displayFolder: Levels EN
		lineageTag: fa495eeb-13db-4ac3-8ea6-fe9e6073b720
		summarizeBy: none
		sourceColumn: L6 EN

		annotation SummarizationSetBy = Automatic

	/// Dichte Reihenfolge in Zehnerschritten. Lücken vermeiden — eine Zeile
	/// ohne Wert fällt auf den DataView-Index zurück und sortiert falsch.
	column SortOrder
		dataType: int64
		formatString: 0
		displayFolder: Steuerung
		lineageTag: ecc31b7d-6e2e-41c0-8213-db51dc1e49d2
		summarizeBy: none
		sourceColumn: SortOrder

		annotation SummarizationSetBy = Automatic

	/// Zeilentyp plus Bestandstoken: "Account stock" nimmt den Wert der
	/// letzten Periode statt der Summe, "Account opening" den der ersten.
	column RowType
		dataType: string
		displayFolder: Steuerung
		lineageTag: 9d5e5f87-35ac-43ed-829a-2975b312c0d7
		summarizeBy: none
		sourceColumn: RowType

		annotation SummarizationSetBy = Automatic

	/// Aus RowType abgeleitet: Summe, Bestand oder Bestand Anfang. Die
	/// Measures mit dem Zusatz Stichtag werten diese Spalte aus.
	column Zeitaggregation
		dataType: string
		displayFolder: Steuerung
		lineageTag: 24799c37-bd74-4837-82ff-4ba9bd7a8cbe
		summarizeBy: none
		sourceColumn: Zeitaggregation

		annotation SummarizationSetBy = Automatic

	/// Formel einer Zwischen- oder Kennzahlenzeile, Referenzen in eckigen
	/// Klammern auf Zeilennamen.
	column FormulaDef
		dataType: string
		displayFolder: Steuerung
		lineageTag: a9d0deef-5f35-4a7c-81e9-441542747478
		summarizeBy: none
		sourceColumn: FormulaDef

		annotation SummarizationSetBy = Automatic

	column 'FormulaDef EN'
		dataType: string
		displayFolder: Steuerung
		lineageTag: 3f6166e2-9e01-4b07-8569-3b2471b0f328
		summarizeBy: none
		sourceColumn: FormulaDef EN

		annotation SummarizationSetBy = Automatic

	/// Wird vor Summen und Formeln anmultipliziert.
	column SignConvention
		dataType: int64
		formatString: 0
		displayFolder: Steuerung
		lineageTag: d005b912-2626-4930-8789-2bbec19f5e32
		summarizeBy: none
		sourceColumn: SignConvention

		annotation SummarizationSetBy = Automatic

	/// Zeile mit umgekehrtem Vorzeichen anzeigen, damit Kostenzeilen
	/// positiv erscheinen.
	column DisplayInvert
		dataType: string
		displayFolder: Steuerung
		lineageTag: cdbaf717-141c-4a4a-8f91-26cef333b059
		summarizeBy: none
		sourceColumn: DisplayInvert

		annotation SummarizationSetBy = Automatic

	/// Weniger ist besser — Abweichung unter Plan wird grün.
	column VarianceInvert
		dataType: string
		displayFolder: Steuerung
		lineageTag: c1566012-45e4-4cbe-8df2-55272fd1a60e
		summarizeBy: none
		sourceColumn: VarianceInvert

		annotation SummarizationSetBy = Automatic

	column Kommentar
		dataType: string
		displayFolder: Fußnoten
		lineageTag: 59286236-9895-4331-828a-e4346c6dbf4f
		summarizeBy: none
		sourceColumn: Kommentar

		annotation SummarizationSetBy = Automatic

	column 'Comment EN'
		dataType: string
		displayFolder: Fußnoten
		lineageTag: 44b4b219-eab0-4b5c-8e32-806b7a460347
		summarizeBy: none
		sourceColumn: Comment EN

		annotation SummarizationSetBy = Automatic

	/// Sortierschlüssel je L1-Position: kleinste SortOrder der Zeile, damit
	/// die Core-Matrix die GuV in Bilanzreihenfolge zeigt statt alphabetisch.
	column 'L1 Sort' =
			CALCULATE (
			    MIN ( 'dim-konten'[SortOrder] ),
			    ALLEXCEPT ( 'dim-konten', 'dim-konten'[L1] )
			)
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Steuerung
		lineageTag: 2c11e3d9-85a9-4709-a55e-3a8ddf9386d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim-konten = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(DemoPfad & "dim-konten.csv"), [Delimiter = ";", Columns = 29, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Header, {{"AccountID", type text}, {"ParentAccountID", type text}, {"Kontonummer", type text}, {"Abschluss", type text}, {"Statement", type text}, {"Name", type text}, {"Name EN", type text}, {"L1", type text}, {"L2", type text}, {"L3", type text}, {"L4", type text}, {"L5", type text}, {"L6", type text}, {"L1 EN", type text}, {"L2 EN", type text}, {"L3 EN", type text}, {"L4 EN", type text}, {"L5 EN", type text}, {"L6 EN", type text}, {"SortOrder", Int64.Type}, {"RowType", type text}, {"Zeitaggregation", type text}, {"FormulaDef", type text}, {"FormulaDef EN", type text}, {"SignConvention", Int64.Type}, {"DisplayInvert", type text}, {"VarianceInvert", type text}, {"Kommentar", type text}, {"Comment EN", type text}}, "en-US")
				in
				    Typen

	annotation PBI_ResultType = Table

