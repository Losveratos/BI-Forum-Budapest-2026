/// Values per account, company and month in mEUR. Scenarios AC (actual), PY
/// (previous year), PL (plan), FC (forecast) plus the full-year scalars FC_FY and
/// PL_FY.
table fact-abschluss
	lineageTag: aa1ddf8e-7e8e-405e-87c0-33f2fda07361

	column AccountID
		dataType: string
		lineageTag: 42ff4336-d570-49d3-844d-baf29f140c15
		summarizeBy: none
		sourceColumn: AccountID

		annotation SummarizationSetBy = Automatic

	column EntityID
		dataType: string
		lineageTag: 83e682b1-a78d-4cb0-8312-3e5b64ec2f92
		summarizeBy: none
		sourceColumn: EntityID

		annotation SummarizationSetBy = Automatic

	/// Last day of the month, link to the date dimension.
	column Datum
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: dcfd8fe6-0e4b-41b9-85b5-376cf7097ed9
		summarizeBy: none
		sourceColumn: Datum

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Period key as text YYYY-MM. This column belongs in the role
	/// "Period" of the visual.
	column Monat
		dataType: string
		lineageTag: dd6be4eb-de2d-4116-81d9-7e919e901639
		summarizeBy: none
		sourceColumn: Monat

		annotation SummarizationSetBy = Automatic

	/// Actual in EUR, base units. The columns without a suffix are
	/// group currency, those with "_LW" local currency.
	column 'AC Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 8185d803-10c7-4a31-8575-d43f69a0fcb4
		summarizeBy: sum
		sourceColumn: AC

		annotation SummarizationSetBy = User

	/// Actual in the local currency of the company, base units.
	column 'AC LW Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 38a05b30-a035-481a-8839-83cb508a2893
		summarizeBy: sum
		sourceColumn: AC_LW

		annotation SummarizationSetBy = User

	column 'PY Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: ccb1d11e-cadf-4d6f-85ef-c3c89b864db4
		summarizeBy: sum
		sourceColumn: PY

		annotation SummarizationSetBy = User

	column 'PY LW Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 7159be2c-98d5-4328-8e68-90defa7fcf44
		summarizeBy: sum
		sourceColumn: PY_LW

		annotation SummarizationSetBy = User

	column 'PL Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 667b3434-aad9-4e89-883e-b5d516346957
		summarizeBy: sum
		sourceColumn: PL

		annotation SummarizationSetBy = User

	column 'PL LW Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 781bac07-5fec-45f8-8197-8663d461fc85
		summarizeBy: sum
		sourceColumn: PL_LW

		annotation SummarizationSetBy = User

	column 'FC Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 8615dadd-9c63-40cf-8f68-f37ee76e18ce
		summarizeBy: sum
		sourceColumn: FC

		annotation SummarizationSetBy = User

	column 'FC LW Wert'
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: e25b9c7a-67f9-4f25-8b47-3314569e5cf9
		summarizeBy: sum
		sourceColumn: FC_LW

		annotation SummarizationSetBy = User

	/// Annual scalar, identical on every month row of the year. Aggregate only with MAX,
	/// never with SUM.
	column FC_FY
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: f0756245-da14-496c-8b51-93f83a68b516
		summarizeBy: sum
		sourceColumn: FC_FY

		annotation SummarizationSetBy = User

	column FC_FY_LW
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 8f59c48f-ccd8-47ca-8372-ffdb04de4d30
		summarizeBy: sum
		sourceColumn: FC_FY_LW

		annotation SummarizationSetBy = User

	/// Annual scalar, identical on every month row of the year. Aggregate only with MAX,
	/// never with SUM.
	column PL_FY
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: 40847ea7-e866-47f2-81fb-ed909ae810ed
		summarizeBy: sum
		sourceColumn: PL_FY

		annotation SummarizationSetBy = User

	column PL_FY_LW
		dataType: double
		isHidden
		formatString: #,##0
		lineageTag: db2464de-9870-4ff3-8958-a3c5dd23417c
		summarizeBy: sum
		sourceColumn: PL_FY_LW

		annotation SummarizationSetBy = User

	partition fact-abschluss = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(DemoPfad & "fact-abschluss.csv"), [Delimiter = ";", Columns = 16, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Header, {{"AccountID", type text}, {"EntityID", type text}, {"Datum", type date}, {"Monat", type text}, {"AC", type number}, {"AC_LW", type number}, {"PY", type number}, {"PY_LW", type number}, {"PL", type number}, {"PL_LW", type number}, {"FC", type number}, {"FC_LW", type number}, {"FC_FY", type number}, {"FC_FY_LW", type number}, {"PL_FY", type number}, {"PL_FY_LW", type number}}, "en-US")
				in
				    Typen

	annotation PBI_ResultType = Table

