	/// Forecast in der Landeswährung der Gesellschaft. Liefert BLANK,
	/// sobald mehr als eine Währung im Filter liegt — eine Summe über CHF
	/// und JPY wäre bedeutungslos.
	measure 'FC LW' =
			IF (
			    HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			    SUM ( 'fact-abschluss'[FC LW Wert] )
			)
		formatString: #,##0
		displayFolder: Szenarien (Landeswährung)
		lineageTag: faa121dd-7a9d-4dfb-85b3-ab4345f63281

	/// Forecast für das ganze Geschäftsjahr in EUR. Der Wert steht
	/// identisch auf jeder Monatszeile, deshalb MAX je Gesellschaft und
	/// Jahr statt SUM.
	measure 'FC FY' =
			VAR _Scope =
			    SUMMARIZE (
			        'fact-abschluss',
			        'fact-abschluss'[AccountID],
			        'fact-abschluss'[EntityID],
			        'dim-datum'[Jahr]
			    )
			RETURN
			    SUMX ( _Scope, CALCULATE ( MAX ( 'fact-abschluss'[FC_FY] ) ) )
		formatString: #,##0
		displayFolder: Jahresskalare
		lineageTag: 25cf730f-af9d-4853-821f-75224bec1dcd

	/// Plan für das ganze Geschäftsjahr in EUR, gleiche Logik wie FC FY.
	measure 'PL FY' =
			VAR _Scope =
			    SUMMARIZE (
			        'fact-abschluss',
			        'fact-abschluss'[AccountID],
			        'fact-abschluss'[EntityID],
			        'dim-datum'[Jahr]
			    )
			RETURN
			    SUMX ( _Scope, CALCULATE ( MAX ( 'fact-abschluss'[PL_FY] ) ) )
		formatString: #,##0
		displayFolder: Jahresskalare
		lineageTag: c98dc26a-ffa2-41c2-84bf-3a0989ef81a9

