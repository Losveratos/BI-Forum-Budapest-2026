	/// Wie AC, aber bestandsrichtig: Bilanzzeilen werden nicht über die
	/// Perioden summiert, sondern mit dem Wert des Stichtags gezeigt. Für
	/// Karten und Matrizen außerhalb des P&L-Visuals — das Visual selbst
	/// braucht das nicht.
	measure 'AC Stichtag' =
			VAR _Fluss =
			    CALCULATE (
			        SUM ( 'fact-abschluss'[AC Wert] ),
			        KEEPFILTERS ( 'dim-konten'[Zeitaggregation] = "Summe" )
			    )
			VAR _Erste = CALCULATE ( MIN ( 'fact-abschluss'[Datum] ), REMOVEFILTERS ( 'dim-konten' ) )
			VAR _Letzte = CALCULATE ( MAX ( 'fact-abschluss'[Datum] ), REMOVEFILTERS ( 'dim-konten' ) )
			VAR _Bestand =
			    CALCULATE (
			        SUM ( 'fact-abschluss'[AC Wert] ),
			        KEEPFILTERS ( 'dim-konten'[Zeitaggregation] = "Bestand" ),
			        'fact-abschluss'[Datum] = _Letzte
			    )
			VAR _Anfang =
			    CALCULATE (
			        SUM ( 'fact-abschluss'[AC Wert] ),
			        KEEPFILTERS ( 'dim-konten'[Zeitaggregation] = "Bestand Anfang" ),
			        'fact-abschluss'[Datum] = _Erste
			    )
			RETURN
			    _Fluss + _Bestand + _Anfang
		formatString: #,##0
		displayFolder: Bestandssicher
		lineageTag: 414f0ce5-41ea-4ade-8158-77d0fd9e58d5

	/// Wie PY, aber bestandsrichtig: Bilanzzeilen werden nicht über die
