	/// Revenue — Szenario AC. Umsatzerlöse als Skalar, Erlösschmälerungen
	/// korrekt abgezogen. Für ChartKitchen und Karten — das P&L-Visual
	/// braucht sie nicht, es rechnet das Vorzeichen selbst.
	measure 'Revenue AC' =
			CALCULATE (
			    SUMX (
			        'fact-abschluss',
			        'fact-abschluss'[AC Wert] * RELATED ( 'dim-konten'[SignConvention] )
			    ),
			    KEEPFILTERS ( 'dim-konten'[L1 EN] = "Net revenue" )
			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: 5d0a8ead-9fc8-4a9a-87e0-4170e987d4e8

	/// Revenue — Szenario PY. Umsatzerlöse als Skalar, Erlösschmälerungen
