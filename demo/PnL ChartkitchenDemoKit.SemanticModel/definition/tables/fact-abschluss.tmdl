	/// EBITDA — Szenario AC. EBITDA als Skalar: die Summe der sechs
	/// operativen GuV-Blöcke. Geht auf, weil SignConvention die Kosten
	/// negativ trägt. Formelzeilen fließen nicht ein, sie liegen in der
	/// Faktentabelle auf 0. v3: über [AC], also inklusive Nachbuchung bei Schalter an.
	measure 'EBITDA AC' =
			CALCULATE (
			    SUMX (
			        VALUES ( 'dim-konten'[SignConvention] ),
			        'dim-konten'[SignConvention] * [AC]
			    ),
			    KEEPFILTERS ( 'dim-konten'[L1 EN] IN { "Net revenue", "Cost of sales", "Selling expenses", "Administrative expenses", "Research & development", "Other operating result" } )
			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: bb2b81bf-a5b6-4959-8b22-6a34db74801d

