	/// Textmeasure für die Rolle "Filter info" des Visuals: zeigt
	/// Gesellschaft, Region und Zeitraum in der Fußzeile. Muss Text
	/// liefern, Zahlen würden unformatiert ausgegeben.
	measure Filterinfo =
			VAR _Wae =
			    IF (
			        HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			        VALUES ( 'dim-gesellschaft'[Währung] ),
			        "EUR"
			    )
			VAR _Ges =
			    IF (
			        ISCROSSFILTERED ( 'dim-gesellschaft' ),
			        CONCATENATEX (
			            VALUES ( 'dim-gesellschaft'[Kurzname] ),
			            'dim-gesellschaft'[Kurzname],
			            ", ",
			            'dim-gesellschaft'[Kurzname]
			        ),
			        "Group"
			    )
			VAR _Reg =
			    IF (
			        ISFILTERED ( 'dim-region'[Region] ),
			        " · " & CONCATENATEX (
			            VALUES ( 'dim-region'[Region] ),
			            'dim-region'[Region],
			            ", ",
			            'dim-region'[Region]
			        ),
			        ""
			    )
			VAR _Von = MIN ( 'fact-abschluss'[Monat] )
			VAR _Bis = MAX ( 'fact-abschluss'[Monat] )
			VAR _Per = " · " & IF ( _Von = _Bis, _Von, _Von & " to " & _Bis )
			RETURN
			    _Ges & _Reg & _Per & " · " & _Wae
		displayFolder: Beschriftung
		lineageTag: 38e32dad-6fd3-401a-8fc3-8d4324b59502

	/// GuV only. Ist vorzeichenrichtig: Kontenzeilen mal SignConvention, nur RowType "account"
	/// und Statement "Income statement". Erlöse positiv, Kosten negativ, damit Core-Visuals ohne
	/// Vorzeichen-Wissen auskommen. Ergebnis in Mio. EUR (durch 1.000.000 geteilt).
	/// v3: über [AC], zieht also die Nachbuchung mit, wenn der Schalter an ist.
	measure 'AC signed' =
			CALCULATE (
			    SUMX (
			        VALUES ( 'dim-konten'[SignConvention] ),
			        'dim-konten'[SignConvention] * [AC]
			    ) / 1000000,
			    KEEPFILTERS ( 'dim-konten'[RowType] = "account" ),
			    KEEPFILTERS ( 'dim-konten'[Statement] = "Income statement" )
			)
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: 2018637a-0635-40c9-a523-f6093cf2fecc

	/// GuV only. Vorjahr vorzeichenrichtig: Kontenzeilen mal SignConvention, nur RowType "account"
	/// und Statement "Income statement". Erlöse positiv, Kosten negativ, damit Core-Visuals ohne
	/// Vorzeichen-Wissen auskommen. Ergebnis in Mio. EUR (durch 1.000.000 geteilt).
	measure 'PY signed' =
			CALCULATE (
			    SUMX (
			        VALUES ( 'dim-konten'[SignConvention] ),
			        'dim-konten'[SignConvention] * CALCULATE ( SUM ( 'fact-abschluss'[PY Wert] ) )
			    ) / 1000000,
			    KEEPFILTERS ( 'dim-konten'[RowType] = "account" ),
			    KEEPFILTERS ( 'dim-konten'[Statement] = "Income statement" )
			)
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: 46662be2-587d-4be8-995a-356bbfc5d3cc

