/// Werte je Konto, Gesellschaft und Monat in mEUR. Szenarien AC (Ist), PY
/// (Vorjahr), PL (Plan), FC (Forecast) plus die Jahresskalare FC_FY und
/// PL_FY.
table fact-abschluss
	lineageTag: aa1ddf8e-7e8e-405e-87c0-33f2fda07361

	/// Ist in Konzernwährung EUR. Erfolgsposten zum Durchschnittskurs des
	/// Monats, Bilanzposten zum Stichtagskurs. Bestandszeilen regelt das
	/// Visual selbst über das Token "stock" in RowType. v3: plus die
	/// Nachbuchung aus fact-nachbuchung, wenn 'close-status' auf "Incl. day-3
	/// adjustment" steht (sonst unverändert).
	measure AC = SUM ( 'fact-abschluss'[AC Wert] ) + [AC adjustment]
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: f894edd2-d181-48f5-84f2-784690f1eaad

	/// Vorjahr in EUR, monatsgenau verschoben. Für 2026 ist PY gleich dem
	/// Ist 2025 — jeweils zum Kurs des damaligen Monats.
	measure PY = SUM ( 'fact-abschluss'[PY Wert] )
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: c9b3ac54-a861-4259-8725-c50ae9e80294

	/// Plan in EUR.
	measure PL = SUM ( 'fact-abschluss'[PL Wert] )
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: 1b64b778-4fe5-457a-8e79-4e011a6b1a9b

	/// Forecast in EUR: Ist für die geschlossenen Monate, Hochrechnung für
	/// November und Dezember 2026.
	measure FC = SUM ( 'fact-abschluss'[FC Wert] )
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: 6f95b199-b3da-4fae-87b3-fd6af80fbf2d

	/// Ist in der Landeswährung der Gesellschaft. Liefert BLANK, sobald
	/// mehr als eine Währung im Filter liegt — eine Summe über CHF und JPY
	/// wäre bedeutungslos.
	measure 'AC LW' =
			IF (
			    HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			    SUM ( 'fact-abschluss'[AC LW Wert] ) + [AC LW adjustment]
			)
		formatString: #,##0
		displayFolder: Szenarien (Landeswährung)
		lineageTag: 379f23f9-07f3-4dba-8cdb-4111c886a90b

	/// Vorjahr in der Landeswährung der Gesellschaft. Liefert BLANK, sobald
	/// mehr als eine Währung im Filter liegt — eine Summe über CHF und JPY
	/// wäre bedeutungslos.
	measure 'PY LW' =
			IF (
			    HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			    SUM ( 'fact-abschluss'[PY LW Wert] )
			)
		formatString: #,##0
		displayFolder: Szenarien (Landeswährung)
		lineageTag: 91dafa38-cf97-4b9d-8dae-0980ae5c0733

	/// Plan in der Landeswährung der Gesellschaft. Liefert BLANK, sobald
