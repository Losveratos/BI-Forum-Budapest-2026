	partition dim-waehrung = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(DemoPfad & "dim-waehrung.csv"), [Delimiter = ";", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Header, {{"Währung", type text}, {"Name", type text}, {"Name EN", type text}, {"Symbol", type text}, {"Nachkommastellen", Int64.Type}, {"IstKonzernwährung", type text}, {"Sortierung", Int64.Type}}, "en-US")
				in
				    Typen

	annotation PBI_ResultType = Table

