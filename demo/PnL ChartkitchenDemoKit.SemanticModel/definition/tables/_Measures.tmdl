			    ),
			    KEEPFILTERS ( 'dim-konten'[L1 EN] = "Net revenue" )
			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: 853aea18-89f5-448b-86f6-aa4282435cd9

	/// Revenue — scenario PL. Net revenue as a scalar, revenue deductions
