	/// Scenarios rung 2: copy of Revenue AC mEUR as an invisible, fully overlapped second series.
	/// It only carries the PY error bar so that PL and PY can both be drawn as ticks on the AC bar.
	measure 'Rev AC carrier mEUR' = [Revenue AC mEUR]
		formatString: #,##0.0
		displayFolder: Budapest demo\Scenarios
		lineageTag: d54c3640-4546-46b1-bf65-1c9601b245d9

	/// Scenarios rung 3, hand-written SVG: horizontal IBCS bars per company, PY grey offset up, PL outline
	/// offset down, AC dark in front, AC label. Scaled across the visible companies (both sort columns). ImageUrl.
	measure 'Rev AC PL PY bars SVG' =
			VAR _Ac = [Revenue AC mEUR]
			VAR _Pl = [Revenue PL mEUR]
			VAR _Py = [Revenue PY mEUR]
			VAR _Max =
			    MAXX (
			        ALLSELECTED ( 'dim-gesellschaft'[Short name], 'dim-gesellschaft'[Sortierung] ),
			        MAX ( MAX ( [Revenue AC mEUR], [Revenue PL mEUR] ), [Revenue PY mEUR] )
			    )
			VAR _Len = 222
			VAR _WAc = DIVIDE ( _Ac, _Max ) * _Len
			VAR _WPl = DIVIDE ( _Pl, _Max ) * _Len
			VAR _WPy = DIVIDE ( _Py, _Max ) * _Len
			VAR _LblX = MAX ( MAX ( _WAc, _WPl ), _WPy ) + 9
			VAR _Svg =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='26' viewBox='0 0 300 26'>"
			        & IF ( NOT ISBLANK ( _Py ), "<rect x='2' y='1' width='" & FORMAT ( _WPy, "0.0", "en-US" ) & "' height='14' fill='%23B4B4B4'/>" )
			        & IF ( NOT ISBLANK ( _Pl ), "<rect x='2.7' y='10.7' width='" & FORMAT ( _WPl - 1.4, "0.0", "en-US" ) & "' height='13.6' fill='%23FFFFFF' stroke='%23404040' stroke-width='1.4'/>" )
			        & "<rect x='2' y='6' width='" & FORMAT ( _WAc, "0.0", "en-US" ) & "' height='14' fill='%23404040'/>"
			        & "<line x1='1' y1='0' x2='1' y2='26' stroke='%23404040' stroke-width='2'/>"
			        & "<text x='" & FORMAT ( _LblX, "0.0", "en-US" ) & "' y='20' font-family='Segoe UI' font-size='19' fill='%23262626'>" & FORMAT ( _Ac, "#,##0.0", "en-US" ) & "</text>"
			        & "</svg>"
			RETURN
			    IF ( ISBLANK ( _Ac ) || NOT ISINSCOPE ( 'dim-gesellschaft'[Short name] ), BLANK (), _Svg )
		displayFolder: Budapest demo\Scenarios
		lineageTag: 9e12f832-7701-4c97-bc46-bf2a1c112387
		dataCategory: ImageUrl

	/// Scenarios rung 3, UDF PowerofBI.IBCS.BarChart.AbsoluteVariance: ΔPL bar per company with plan axis
	/// (two thin lines). Same scale as Rev ΔPY UDF. Blank on the total row. ImageUrl.
	measure 'Rev ΔPL UDF' =
			IF (
			    ISBLANK ( [Rev ΔPL mEUR] ) || NOT ISINSCOPE ( 'dim-gesellschaft'[Short name] ),
			    BLANK (),
			    PowerofBI.IBCS.BarChart.AbsoluteVariance (
			        'dim-gesellschaft'[Short name],
			        [Revenue AC mEUR],
			        BLANK (),
			        [Revenue PL mEUR],
			        MAXX (
			            ALLSELECTED ( 'dim-gesellschaft'[Short name], 'dim-gesellschaft'[Sortierung] ),
			            MAX ( ABS ( [Rev ΔPL mEUR] ), ABS ( [Rev ΔPY mEUR] ) )
			        ),
			        "outlined",
			        FALSE (),
			        FORMAT ( [Rev ΔPL mEUR], "+#,##0.0;-#,##0.0;=", "en-US" ),
			        300,
			        26,
			        1
			    )
			)
		displayFolder: Budapest demo\Scenarios
		lineageTag: ed29e574-7914-4e67-93db-8b30cd37d1ce
		dataCategory: ImageUrl

	/// Scenarios rung 3, UDF PowerofBI.IBCS.BarChart.AbsoluteVariance: ΔPY bar per company with grey
	/// previous-year axis. Same scale as Rev ΔPL UDF. Blank on the total row and without PY. ImageUrl.
	measure 'Rev ΔPY UDF' =
			IF (
			    ISBLANK ( [Rev ΔPY mEUR] ) || NOT ISINSCOPE ( 'dim-gesellschaft'[Short name] ),
			    BLANK (),
			    PowerofBI.IBCS.BarChart.AbsoluteVariance (
			        'dim-gesellschaft'[Short name],
			        [Revenue AC mEUR],
			        BLANK (),
			        [Revenue PY mEUR],
			        MAXX (
			            ALLSELECTED ( 'dim-gesellschaft'[Short name], 'dim-gesellschaft'[Sortierung] ),
			            MAX ( ABS ( [Rev ΔPL mEUR] ), ABS ( [Rev ΔPY mEUR] ) )
			        ),
			        "grey",
			        FALSE (),
			        FORMAT ( [Rev ΔPY mEUR], "+#,##0.0;-#,##0.0;=", "en-US" ),
			        300,
			        26,
			        1
			    )
			)
		displayFolder: Budapest demo\Scenarios
		lineageTag: 906622a0-fa6b-4f94-99d6-06763c5fb7b5
		dataCategory: ImageUrl

	/// Scenarios rung 3, hand-written SVG: one cell per month in a matrix, AC dark column, PY grey offset left,
	/// PL outline offset right, AC label, below ΔPL and ΔPY variance bars. Scale over all months of the
	/// selection, ignoring the month slicer, so a selected month keeps its size. ImageUrl.
	measure 'Rev month SVG' =
			VAR _Ac = [Revenue AC mEUR]
			VAR _Pl = [Revenue PL mEUR]
			VAR _Py = [Revenue PY mEUR]
			VAR _DPl = [Rev ΔPL mEUR]
			VAR _DPy = [Rev ΔPY mEUR]
			VAR _Max =
			    CALCULATE (
			        MAXX (
			            VALUES ( 'dim-datum'[MonatNr] ),
			            MAX ( MAX ( [Revenue AC mEUR], [Revenue PL mEUR] ), [Revenue PY mEUR] )
			        ),
			        REMOVEFILTERS ( 'dim-datum'[Month Short], 'dim-datum'[MonatNr] )
			    )
			VAR _MaxD =
			    CALCULATE (
			        MAXX (
			            VALUES ( 'dim-datum'[MonatNr] ),
			            MAX ( ABS ( [Rev ΔPL mEUR] ), ABS ( [Rev ΔPY mEUR] ) )
			        ),
			        REMOVEFILTERS ( 'dim-datum'[Month Short], 'dim-datum'[MonatNr] )
			    )
			VAR _First =
			    SELECTEDVALUE ( 'dim-datum'[MonatNr] )
			        = CALCULATE ( MIN ( 'dim-datum'[MonatNr] ), REMOVEFILTERS ( 'dim-datum'[Month Short], 'dim-datum'[MonatNr] ) )
			VAR _Base = 186
			VAR _Hgt = 150
			VAR _HAc = DIVIDE ( _Ac, _Max ) * _Hgt
			VAR _HPl = DIVIDE ( _Pl, _Max ) * _Hgt
			VAR _HPy = DIVIDE ( _Py, _Max ) * _Hgt
			VAR _K = DIVIDE ( 26, _MaxD )
			VAR _LPl = ABS ( _DPl ) * _K
			VAR _LPy = ABS ( _DPy ) * _K
			VAR _APl = 236
			VAR _APy = 292
			VAR _CPl = IF ( _DPl >= 0, "%232E8B7A", "%23C0392B" )
			VAR _CPy = IF ( _DPy >= 0, "%232E8B7A", "%23C0392B" )
			VAR _Svg =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='330' viewBox='0 0 140 330'>"
			        & "<text x='70' y='22' font-family='Segoe UI' font-size='21' font-weight='600' text-anchor='middle' fill='%23262626'>" & FORMAT ( _Ac, "#,##0.0", "en-US" ) & "</text>"
			        & IF ( NOT ISBLANK ( _Py ), "<rect x='26' y='" & FORMAT ( _Base - _HPy, "0.0", "en-US" ) & "' width='60' height='" & FORMAT ( _HPy, "0.0", "en-US" ) & "' fill='%23B4B4B4'/>" )
			        & IF ( NOT ISBLANK ( _Pl ), "<rect x='54.7' y='" & FORMAT ( _Base - _HPl + 0.7, "0.0", "en-US" ) & "' width='58.6' height='" & FORMAT ( _HPl - 0.7, "0.0", "en-US" ) & "' fill='%23FFFFFF' stroke='%23404040' stroke-width='1.4'/>" )
			        & "<rect x='40' y='" & FORMAT ( _Base - _HAc, "0.0", "en-US" ) & "' width='60' height='" & FORMAT ( _HAc, "0.0", "en-US" ) & "' fill='%23404040'/>"
			        & "<line x1='14' y1='186' x2='126' y2='186' stroke='%23404040' stroke-width='2'/>"
			        & "<line x1='40' y1='" & ( _APl - 1.5 ) & "' x2='100' y2='" & ( _APl - 1.5 ) & "' stroke='%23404040' stroke-width='1'/>"
			        & "<line x1='40' y1='" & ( _APl + 1.5 ) & "' x2='100' y2='" & ( _APl + 1.5 ) & "' stroke='%23404040' stroke-width='1'/>"
			        & IF ( NOT ISBLANK ( _DPl ), "<rect x='52' y='" & FORMAT ( IF ( _DPl >= 0, _APl - 2 - _LPl, _APl + 2 ), "0.0", "en-US" ) & "' width='36' height='" & FORMAT ( _LPl, "0.0", "en-US" ) & "' fill='" & _CPl & "'/>"
			            & "<text x='70' y='" & FORMAT ( IF ( _DPl >= 0, _APl + 17, _APl - 7 ), "0.0", "en-US" ) & "' font-family='Segoe UI' font-size='17' text-anchor='middle' fill='%23262626'>" & FORMAT ( _DPl, "+#,##0.0;-#,##0.0;0.0", "en-US" ) & "</text>" )
			        & "<line x1='40' y1='" & _APy & "' x2='100' y2='" & _APy & "' stroke='%23B4B4B4' stroke-width='3'/>"
			        & IF ( NOT ISBLANK ( _DPy ), "<rect x='52' y='" & FORMAT ( IF ( _DPy >= 0, _APy - 1.5 - _LPy, _APy + 1.5 ), "0.0", "en-US" ) & "' width='36' height='" & FORMAT ( _LPy, "0.0", "en-US" ) & "' fill='" & _CPy & "'/>"
			            & "<text x='70' y='" & FORMAT ( IF ( _DPy >= 0, _APy + 17, _APy - 7 ), "0.0", "en-US" ) & "' font-family='Segoe UI' font-size='17' text-anchor='middle' fill='%23262626'>" & FORMAT ( _DPy, "+#,##0.0;-#,##0.0;0.0", "en-US" ) & "</text>" )
			        & IF ( _First, "<text x='2' y='" & ( _APl + 4 ) & "' font-family='Segoe UI' font-size='13' fill='%236B6B6B'>ΔPL</text><text x='2' y='" & ( _APy + 4 ) & "' font-family='Segoe UI' font-size='13' fill='%236B6B6B'>ΔPY</text>" )
			        & "</svg>"
			RETURN
			    IF ( ISBLANK ( _Ac ) || NOT ISINSCOPE ( 'dim-datum'[Month Short] ), BLANK (), _Svg )
		displayFolder: Budapest demo\Scenarios
		lineageTag: d3fc9aa5-6b88-439f-aed2-386ac64aa6ca
		dataCategory: ImageUrl

	/// Scenarios rung 3: mini IBCS columns for the month button slicer (AC dark, PY grey, PL outline) with a
	/// teal or red strip for the ΔPL sign. Same month scale as Rev month SVG. ImageUrl.
	measure 'Rev month button SVG' =
			VAR _Ac = [Revenue AC mEUR]
			VAR _Pl = [Revenue PL mEUR]
			VAR _Py = [Revenue PY mEUR]
			VAR _DPl = [Rev ΔPL mEUR]
			VAR _Max =
			    CALCULATE (
			        MAXX (
			            VALUES ( 'dim-datum'[MonatNr] ),
			            MAX ( MAX ( [Revenue AC mEUR], [Revenue PL mEUR] ), [Revenue PY mEUR] )
			        ),
			        REMOVEFILTERS ( 'dim-datum'[Month Short], 'dim-datum'[MonatNr] )
			    )
			VAR _Base = 50
			VAR _Hgt = 46
			VAR _HAc = DIVIDE ( _Ac, _Max ) * _Hgt
			VAR _HPl = DIVIDE ( _Pl, _Max ) * _Hgt
			VAR _HPy = DIVIDE ( _Py, _Max ) * _Hgt
			VAR _C = IF ( _DPl >= 0, "%232E8B7A", "%23C0392B" )
			RETURN
			    IF (
			        ISBLANK ( _Ac ),
			        BLANK (),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='58' viewBox='0 0 100 58'>"
			            & IF ( NOT ISBLANK ( _Py ), "<rect x='24' y='" & FORMAT ( _Base - _HPy, "0.0", "en-US" ) & "' width='30' height='" & FORMAT ( _HPy, "0.0", "en-US" ) & "' fill='%23B4B4B4'/>" )
			            & IF ( NOT ISBLANK ( _Pl ), "<rect x='46.6' y='" & FORMAT ( _Base - _HPl + 0.6, "0.0", "en-US" ) & "' width='28.8' height='" & FORMAT ( _HPl - 0.6, "0.0", "en-US" ) & "' fill='%23FFFFFF' stroke='%23404040' stroke-width='1.2'/>" )
			            & "<rect x='35' y='" & FORMAT ( _Base - _HAc, "0.0", "en-US" ) & "' width='30' height='" & FORMAT ( _HAc, "0.0", "en-US" ) & "' fill='%23404040'/>"
			            & "<line x1='18' y1='50' x2='82' y2='50' stroke='%23404040' stroke-width='1.5'/>"
			            & "<rect x='24' y='53' width='52' height='4' fill='" & _C & "'/>"
			            & "</svg>"
			    )
		displayFolder: Budapest demo\Scenarios
		lineageTag: 8fdd57c4-5165-43a5-8e78-7edf26218159
		dataCategory: ImageUrl

	/// Complications page: background colour of the rung 1 cell, by the first word of the cell
	/// (model, DAX, spec, visual, by hand, not possible). Used by conditional formatting.
	measure 'Complication colour R1' =
			VAR _T = SELECTEDVALUE ( complications[Rung 1 Core] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _T ), BLANK (),
			        LEFT ( _T, 5 ) = "model", "#DDEFE8",
			        LEFT ( _T, 3 ) = "DAX", "#FBEED4",
			        LEFT ( _T, 4 ) = "spec", "#E0E9F5",
			        LEFT ( _T, 6 ) = "visual", "#ECE5F4",
			        LEFT ( _T, 7 ) = "by hand", "#F8E0D3",
			        LEFT ( _T, 12 ) = "not possible", "#E4E4E4",
			        BLANK ()
			    )
		displayFolder: Budapest demo\Complications
		lineageTag: ce91c4b5-c769-4481-9d13-5339af39e030

