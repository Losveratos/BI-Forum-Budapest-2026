			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: 5033ceb2-69fe-4f91-843b-9d26a7953c4b

	/// Revenue — scenario FC. Net revenue as a scalar, revenue deductions
