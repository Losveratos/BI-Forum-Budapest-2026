			)
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: 2def2bba-fecf-41ef-b0ec-1e06ca886a05

	/// Variance actual vs plan, sign-correct: positive is good. Plan only for months with
	/// actuals (Period Status = Actual), so that without a page filter 10 actual months are not compared to 12 plan months.
	measure ΔPL =
			VAR _Ac = [AC signed]
			VAR _Pl = CALCULATE ( [PL signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) )
			RETURN
			    IF ( NOT ISBLANK ( _Ac ), _Ac - _Pl )
		formatString: +#,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: b80f5744-6aa0-441d-ac99-857048119a8c

	/// Variance actual vs plan in percent of the plan of the actual months.
	measure 'ΔPL %' = DIVIDE ( [ΔPL], ABS ( CALCULATE ( [PL signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) ) ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: Budapest demo
		lineageTag: 160bd892-ba89-4734-83d3-6f317c4981cc

	/// Variance actual vs previous year, sign-correct: positive is good. Previous year only for actual months.
	measure ΔPY =
			VAR _Ac = [AC signed]
			VAR _Py = CALCULATE ( [PY signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) )
			RETURN
			    IF ( NOT ISBLANK ( _Ac ), _Ac - _Py )
		formatString: +#,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: d1cbed2d-b925-441c-8f8e-62ab58e244de

	/// Variance actual vs previous year in percent of the previous year of the actual months.
	measure 'ΔPY %' = DIVIDE ( [ΔPY], ABS ( CALCULATE ( [PY signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) ) ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: Budapest demo
		lineageTag: 1c057e4d-f02d-451d-b035-866ffd7c5001

	/// Copy of ΔPL for a separate data bar column in the Core matrix (rung 1), so that the
	/// bar does not cover the number.
	measure 'ΔPL (bar)' = [ΔPL]
		formatString: +#,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: 15757d9c-1683-49f5-89bd-1fa256fc07b4

	/// Rung 2, DAX only: variance bar made of Unicode blocks, scaled to the largest variance
	/// of the visible rows (total row capped at 10 blocks). Negative left of the divider,
	/// positive on the right. Requires a monospace font in the visual.
	measure 'ΔPL bar (text)' =
			VAR _D = [ΔPL]
			VAR _Max =
			    MAXX ( ALLSELECTED ( 'dim-konten'[L1 EN], 'dim-konten'[L1 Sort] ), ABS ( [ΔPL] ) )
			VAR _N = MIN ( 10, ROUND ( DIVIDE ( ABS ( _D ), _Max, 0 ) * 10, 0 ) )
			VAR _Neg = REPT ( " ", 10 - _N ) & REPT ( "█", _N )
			VAR _Pos = REPT ( "█", _N ) & REPT ( " ", 10 - _N )
			RETURN
			    IF (
			        ISBLANK ( _D ),
			        BLANK (),
			        IF ( _D < 0, _Neg & "│" & REPT ( " ", 10 ), REPT ( " ", 10 ) & "│" & _Pos )
			    )
		displayFolder: Budapest demo
		lineageTag: 4c283a3e-bbd8-4722-87a5-8889acbf9382

	/// Rung 2, DAX only: revenue per month as Unicode columns, one character per month (PeriodeSort,
	/// so that year and month are unambiguous), scaled to the highest month of the row.
	measure 'Revenue sparkline (text)' =
			VAR _Months = VALUES ( 'dim-datum'[PeriodeSort] )
			VAR _Max = MAXX ( _Months, [Revenue AC] )
			RETURN
			    CONCATENATEX (
			        _Months,
			        VAR _V = [Revenue AC]
			        VAR _I = ROUND ( DIVIDE ( _V, _Max, 0 ) * 7, 0 ) + 1
			        RETURN
			            IF ( ISBLANK ( _V ), " ", MID ( "▁▂▃▄▅▆▇█", _I, 1 ) ),
			        "",
			        'dim-datum'[PeriodeSort]
			    )
		displayFolder: Budapest demo
		lineageTag: 1fa7c781-528d-4a57-a1ec-c921f3b92c03

	/// Rung 2, DAX only: color code for conditional formatting. Teal (documented IBCS deviation,
	/// as in ChartKitchen) for favorable, red for unfavorable variance.
	measure 'ΔPL status' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [ΔPL] ), BLANK (),
			    [ΔPL] >= 0, "#2E8B7A",
			    "#C0392B"
			)
		displayFolder: Budapest demo
		lineageTag: 221a3618-ad0a-44a9-8f3b-1d3a153dccec

	/// Rung 4, Deneb template: actual for months with Period Status Actual, forecast for forecast
	/// months, as a single series for AC&FC columns against the plan outline. Robust at every level.
	measure 'Revenue AC&FC' =
			CALCULATE ( [Revenue AC], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) )
			    + CALCULATE ( [Revenue FC], KEEPFILTERS ( 'dim-datum'[Period Status] = "Forecast" ) )
		formatString: #,##0
		displayFolder: Budapest demo
		lineageTag: 04eed300-3064-4aac-8939-88dda53ed722

	/// Revenue AC&FC in EUR million for Core charts, tables and Deneb (field name without brackets, because Deneb
	/// cannot read fields with brackets via expression).
	measure 'Revenue ACFC mEUR' = DIVIDE ( [Revenue AC&FC], 1000000 )
		formatString: #,##0.0
		displayFolder: Budapest demo
		lineageTag: e50e831e-492e-4df9-a040-3071d3cf039a

	/// Revenue AC in EUR million for Core charts, tables and Deneb (field name without brackets, because Deneb
	/// cannot read fields with brackets via expression).
	measure 'Revenue AC mEUR' = DIVIDE ( [Revenue AC], 1000000 )
