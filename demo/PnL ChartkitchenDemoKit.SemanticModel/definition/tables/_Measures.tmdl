			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: 53b78227-b859-4ea9-853b-b6720038f2f1

	/// EBITDA — scenario AC. EBITDA as a scalar: the sum of the six
	/// operating income statement blocks. It adds up because SignConvention carries costs
	/// as negative. Formula rows are not included, they are 0 in the
	/// fact table. v3: based on [AC], i.e. including the late posting when the switch is on.
	measure 'EBITDA AC' =
			CALCULATE (
			    SUMX (
			        VALUES ( 'dim-konten'[SignConvention] ),
			        'dim-konten'[SignConvention] * [AC]
			    ),
			    KEEPFILTERS ( 'dim-konten'[L1 EN] IN { "Net revenue", "Cost of sales", "Selling expenses", "Administrative expenses", "Research & development", "Other operating result" } )
			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: bb2b81bf-a5b6-4959-8b22-6a34db74801d

	/// EBITDA — scenario PY. EBITDA as a scalar: the sum of the six
	/// operating income statement blocks. It adds up because SignConvention carries costs
	/// as negative. Formula rows are not included, they are 0 in the
	/// fact table.
	measure 'EBITDA PY' =
			CALCULATE (
			    SUMX (
			        'fact-abschluss',
			        'fact-abschluss'[PY Wert] * RELATED ( 'dim-konten'[SignConvention] )
			    ),
			    KEEPFILTERS ( 'dim-konten'[L1 EN] IN { "Net revenue", "Cost of sales", "Selling expenses", "Administrative expenses", "Research & development", "Other operating result" } )
			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: 14aa84c1-b2e8-458c-8239-81508d9fe5bd

