	/// Text measure for the role "Filter info" of the visual: shows
	/// company, region and period in the footer. Must return text,
	/// numbers would be output unformatted.
	measure Filterinfo =
			VAR _Wae =
			    IF (
			        HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			        VALUES ( 'dim-gesellschaft'[Währung] ),
			        "EUR"
			    )
			VAR _Ges =
			    IF (
			        ISCROSSFILTERED ( 'dim-gesellschaft' ),
			        CONCATENATEX (
			            VALUES ( 'dim-gesellschaft'[Kurzname] ),
			            'dim-gesellschaft'[Kurzname],
			            ", ",
			            'dim-gesellschaft'[Kurzname]
			        ),
			        "Group"
			    )
			VAR _Reg =
			    IF (
			        ISFILTERED ( 'dim-region'[Region] ),
			        " · " & CONCATENATEX (
			            VALUES ( 'dim-region'[Region] ),
			            'dim-region'[Region],
			            ", ",
			            'dim-region'[Region]
			        ),
			        ""
			    )
			VAR _Von = MIN ( 'fact-abschluss'[Monat] )
			VAR _Bis = MAX ( 'fact-abschluss'[Monat] )
			VAR _Per = " · " & IF ( _Von = _Bis, _Von, _Von & " to " & _Bis )
			RETURN
			    _Ges & _Reg & _Per & " · " & _Wae
		displayFolder: Beschriftung
		lineageTag: 38e32dad-6fd3-401a-8fc3-8d4324b59502

	/// Income statement only. Actual, sign-correct: account rows times SignConvention, only RowType "account"
	/// and Statement "Income statement". Revenue positive, costs negative, so that Core visuals need no
	/// sign knowledge. Result in EUR million (divided by 1,000,000).
	/// v3: based on [AC], so it includes the late posting when the switch is on.
	measure 'AC signed' =
			CALCULATE (
			    SUMX (
			        VALUES ( 'dim-konten'[SignConvention] ),
			        'dim-konten'[SignConvention] * [AC]
			    ) / 1000000,
			    KEEPFILTERS ( 'dim-konten'[RowType] = "account" ),
			    KEEPFILTERS ( 'dim-konten'[Statement] = "Income statement" )
			)
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: 2018637a-0635-40c9-a523-f6093cf2fecc

	/// Income statement only. Previous year, sign-correct: account rows times SignConvention, only RowType "account"
	/// and Statement "Income statement". Revenue positive, costs negative, so that Core visuals need no
	/// sign knowledge. Result in EUR million (divided by 1,000,000).
	measure 'PY signed' =
			CALCULATE (
			    SUMX (
			        VALUES ( 'dim-konten'[SignConvention] ),
			        'dim-konten'[SignConvention] * CALCULATE ( SUM ( 'fact-abschluss'[PY Wert] ) )
			    ) / 1000000,
			    KEEPFILTERS ( 'dim-konten'[RowType] = "account" ),
			    KEEPFILTERS ( 'dim-konten'[Statement] = "Income statement" )
			)
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo
		lineageTag: 46662be2-587d-4be8-995a-356bbfc5d3cc

