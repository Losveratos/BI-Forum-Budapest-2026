/// Home table for all model measures. Holds no data of its own: a Power Query
/// (M) partition loads one hidden placeholder row. The measures keep their
/// display folders.
table _Measures
	lineageTag: 33dd1ee1-22c5-46b5-a37c-6c99b1b7f99b

	/// Actual in group currency EUR. Income statement items at the average rate of the
	/// month, balance sheet items at the closing rate. The visual itself handles stock rows
	/// via the token "stock" in RowType. v3: plus the late posting from
	/// fact-nachbuchung when 'close-status' is set to "Incl. day-3
	/// adjustment" (otherwise unchanged).
	measure AC = SUM ( 'fact-abschluss'[AC Wert] ) + [AC adjustment]
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: f894edd2-d181-48f5-84f2-784690f1eaad

	/// Previous year in EUR, shifted by month. For 2026, PY equals
	/// actual 2025 — each at the rate of the month at that time.
	measure PY = SUM ( 'fact-abschluss'[PY Wert] )
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: c9b3ac54-a861-4259-8725-c50ae9e80294

	/// Plan in EUR.
	measure PL = SUM ( 'fact-abschluss'[PL Wert] )
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: 1b64b778-4fe5-457a-8e79-4e011a6b1a9b

	/// Forecast in EUR: actual for the closed months, projection for
	/// November and December 2026.
	measure FC = SUM ( 'fact-abschluss'[FC Wert] )
		formatString: #,##0
		displayFolder: Szenarien (EUR)
		lineageTag: 6f95b199-b3da-4fae-87b3-fd6af80fbf2d

	/// Actual in the local currency of the company. Returns BLANK as soon as
	/// more than one currency is in the filter — a sum across CHF and JPY
	/// would be meaningless.
	measure 'AC LW' =
			IF (
			    HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			    SUM ( 'fact-abschluss'[AC LW Wert] ) + [AC LW adjustment]
			)
		formatString: #,##0
		displayFolder: Szenarien (Landeswährung)
		lineageTag: 379f23f9-07f3-4dba-8cdb-4111c886a90b

	/// Previous year in the local currency of the company. Returns BLANK as soon as
	/// more than one currency is in the filter — a sum across CHF and JPY
	/// would be meaningless.
	measure 'PY LW' =
			IF (
			    HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			    SUM ( 'fact-abschluss'[PY LW Wert] )
			)
		formatString: #,##0
		displayFolder: Szenarien (Landeswährung)
		lineageTag: 91dafa38-cf97-4b9d-8dae-0980ae5c0733

	/// Plan in the local currency of the company. Returns BLANK as soon as
	/// more than one currency is in the filter — a sum across CHF and JPY
	/// would be meaningless.
	measure 'PL LW' =
			IF (
			    HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			    SUM ( 'fact-abschluss'[PL LW Wert] )
			)
		formatString: #,##0
		displayFolder: Szenarien (Landeswährung)
		lineageTag: 3232c7c7-7eed-434a-8741-4c79effa53b0

	/// Forecast in the local currency of the company. Returns BLANK
	/// as soon as more than one currency is in the filter — a sum across CHF
	/// and JPY would be meaningless.
	measure 'FC LW' =
			IF (
			    HASONEVALUE ( 'dim-gesellschaft'[Währung] ),
			    SUM ( 'fact-abschluss'[FC LW Wert] )
			)
		formatString: #,##0
		displayFolder: Szenarien (Landeswährung)
		lineageTag: faa121dd-7a9d-4dfb-85b3-ab4345f63281

	/// Forecast for the full fiscal year in EUR. The value is
	/// identical on every month row, hence MAX per company and
	/// year instead of SUM.
	measure 'FC FY' =
			VAR _Scope =
			    SUMMARIZE (
			        'fact-abschluss',
			        'fact-abschluss'[AccountID],
			        'fact-abschluss'[EntityID],
			        'dim-datum'[Jahr]
			    )
			RETURN
			    SUMX ( _Scope, CALCULATE ( MAX ( 'fact-abschluss'[FC_FY] ) ) )
		formatString: #,##0
		displayFolder: Jahresskalare
		lineageTag: 25cf730f-af9d-4853-821f-75224bec1dcd

	/// Plan for the full fiscal year in EUR, same logic as FC FY.
	measure 'PL FY' =
			VAR _Scope =
			    SUMMARIZE (
			        'fact-abschluss',
			        'fact-abschluss'[AccountID],
			        'fact-abschluss'[EntityID],
			        'dim-datum'[Jahr]
			    )
			RETURN
			    SUMX ( _Scope, CALCULATE ( MAX ( 'fact-abschluss'[PL_FY] ) ) )
		formatString: #,##0
		displayFolder: Jahresskalare
		lineageTag: c98dc26a-ffa2-41c2-84bf-3a0989ef81a9

	/// Forecast for the fiscal year in local currency.
	measure 'FC FY LW' =
			VAR _Scope =
			    SUMMARIZE (
			        'fact-abschluss',
			        'fact-abschluss'[AccountID],
			        'fact-abschluss'[EntityID],
			        'dim-datum'[Jahr]
			    )
			RETURN
			    SUMX ( _Scope, CALCULATE ( MAX ( 'fact-abschluss'[FC_FY_LW] ) ) )
		formatString: #,##0
		displayFolder: Jahresskalare
		lineageTag: c0f2a272-c43e-49b0-807d-2563545295ad

	/// Plan for the fiscal year in local currency.
	measure 'PL FY LW' =
			VAR _Scope =
			    SUMMARIZE (
			        'fact-abschluss',
			        'fact-abschluss'[AccountID],
			        'fact-abschluss'[EntityID],
			        'dim-datum'[Jahr]
			    )
			RETURN
			    SUMX ( _Scope, CALCULATE ( MAX ( 'fact-abschluss'[PL_FY_LW] ) ) )
		formatString: #,##0
		displayFolder: Jahresskalare
		lineageTag: 6195e91a-5cf8-4930-8ca0-ae62ea338c4d

	/// Revenue — scenario AC. Net revenue as a scalar, revenue deductions
	/// correctly subtracted. For ChartKitchen and cards — the P&L visual
	/// does not need it, it handles the sign itself.
	measure 'Revenue AC' =
			CALCULATE (
			    SUMX (
			        'fact-abschluss',
			        'fact-abschluss'[AC Wert] * RELATED ( 'dim-konten'[SignConvention] )
			    ),
			    KEEPFILTERS ( 'dim-konten'[L1 EN] = "Net revenue" )
			)
		formatString: #,##0
		displayFolder: ChartKitchen (vorzeichenrichtig)
		lineageTag: 5d0a8ead-9fc8-4a9a-87e0-4170e987d4e8

	/// Revenue — scenario PY. Net revenue as a scalar, revenue deductions
	/// correctly subtracted. For ChartKitchen and cards — the P&L visual
