	/// Rung 4, Deneb template: 1 for forecast months (Period Status = Forecast), otherwise 0. Controls
	/// outline and dashing of the FC columns in the Vega-Lite template.
	measure 'FC flag' = IF ( SELECTEDVALUE ( 'dim-datum'[Period Status] ) = "Forecast", 1, 0 )
		formatString: 0
		displayFolder: Budapest demo
		lineageTag: 90e6b3d8-cf9d-47c2-a1bf-d1a7f6a7b7c2

	/// Rung 3, SVG measure: variance bar on a base scale with a double line as plan reference,
	/// teal good, red bad, value in EUR million as label. Data category ImageUrl, shown as an image in the
	/// matrix. Bar limited to the cell width, coordinates in en-US format.
	measure 'ΔPL SVG' =
			VAR _D = [ΔPL]
			VAR _Max =
			    MAXX ( ALLSELECTED ( 'dim-konten'[L1 EN], 'dim-konten'[L1 Sort] ), ABS ( [ΔPL] ) )
			VAR _W = 160
			VAR _H = 18
			VAR _Mid = _W / 2
			VAR _Len = MIN ( 1, DIVIDE ( ABS ( _D ), _Max, 0 ) ) * ( _Mid - 44 )
			VAR _X = IF ( _D < 0, _Mid - _Len, _Mid )
			VAR _Col = IF ( _D >= 0, "%232E8B7A", "%23C0392B" )
			VAR _Lbl = FORMAT ( _D, "+#,##0.0;-#,##0.0", "en-US" )
			VAR _LblX = IF ( _D < 0, _Mid + 5, _Mid - 5 )
			VAR _Anchor = IF ( _D < 0, "start", "end" )
			VAR _Svg =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "' viewBox='0 0 " & _W & " " & _H & "'>"
			        & "<line x1='" & ( _Mid - 1.5 ) & "' y1='0' x2='" & ( _Mid - 1.5 ) & "' y2='" & _H & "' stroke='%23404040' stroke-width='1'/>"
			        & "<line x1='" & ( _Mid + 1.5 ) & "' y1='0' x2='" & ( _Mid + 1.5 ) & "' y2='" & _H & "' stroke='%23404040' stroke-width='1'/>"
			        & "<rect x='" & FORMAT ( _X, "0.0", "en-US" ) & "' y='3' width='" & FORMAT ( _Len, "0.0", "en-US" ) & "' height='" & ( _H - 6 ) & "' fill='" & _Col & "'/>"
			        & "<text x='" & _LblX & "' y='13' font-family='Segoe UI' font-size='10' text-anchor='" & _Anchor & "' fill='%23222'>" & _Lbl & "</text>"
			        & "</svg>"
			RETURN
			    IF ( ISBLANK ( _D ), BLANK (), _Svg )
		displayFolder: Budapest demo
		lineageTag: 1ebc2016-2a62-4686-ad9e-a21de923920e
		dataCategory: ImageUrl

	/// Rung 3, SVG measure: revenue per month as columns (AC filled) with plan outline, 160 px wide,
	/// one slot per month (PeriodeSort), scaled to the highest value of the row. Data category ImageUrl.
	measure 'Revenue AC vs PL SVG' =
			VAR _Months = VALUES ( 'dim-datum'[PeriodeSort] )
			VAR _Max =
			    MAXX ( _Months, MAX ( [Revenue AC], [Revenue PL] ) )
			VAR _W = 160
			VAR _H = 28
			VAR _N = COUNTROWS ( _Months )
			VAR _Slot = DIVIDE ( _W, _N )
			VAR _Bars =
			    CONCATENATEX (
			        _Months,
			        VAR _I = RANKX ( _Months, 'dim-datum'[PeriodeSort], , ASC ) - 1
			        VAR _Ac = DIVIDE ( [Revenue AC], _Max ) * ( _H - 2 )
			        VAR _Pl = DIVIDE ( [Revenue PL], _Max ) * ( _H - 2 )
			        VAR _X = _I * _Slot + 1
			        VAR _Bw = _Slot - 3
			        RETURN
			            "<rect x='" & FORMAT ( _X, "0.0", "en-US" ) & "' y='" & FORMAT ( _H - _Ac, "0.0", "en-US" ) & "' width='" & FORMAT ( _Bw, "0.0", "en-US" ) & "' height='" & FORMAT ( _Ac, "0.0", "en-US" ) & "' fill='%23404040'/>"
			                & "<rect x='" & FORMAT ( _X, "0.0", "en-US" ) & "' y='" & FORMAT ( _H - _Pl, "0.0", "en-US" ) & "' width='" & FORMAT ( _Bw, "0.0", "en-US" ) & "' height='" & FORMAT ( _Pl, "0.0", "en-US" ) & "' fill='none' stroke='%23404040' stroke-width='1'/>",
			        "",
			        'dim-datum'[PeriodeSort]
			    )
			RETURN
			    IF (
			        ISBLANK ( [Revenue AC] ),
			        BLANK (),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "' viewBox='0 0 " & _W & " " & _H & "'>" & _Bars & "</svg>"
			    )
		displayFolder: Budapest demo
		lineageTag: 8af91ac0-4948-4486-962e-22f8f43bdb67
		dataCategory: ImageUrl

	/// Data status stamp for every demo page (card below the title): last actual month, plan and
	/// forecast version, unit, sign convention. v3: with close status from 'close-status'.
	measure 'Data as of' =
			VAR _LastAct =
			    CALCULATE (
			        MAX ( 'dim-datum'[Monatsende] ),
			        REMOVEFILTERS ( 'dim-datum' ),
			        'dim-datum'[Period Status] = "Actual"
			    )
			VAR _Close =
			    IF ( [Adjustment on], " · incl. day-3 adjustment", " · close status: closed WD3" )
			RETURN
			    "DWG Industries · actuals to " & FORMAT ( _LastAct, "mmm yyyy", "en-US" ) & _Close
			        & " · plan v2026-1 and forecast 10+2 to Dec 2026 · EUR m · variances signed, positive is favourable"
		displayFolder: Budapest demo
		lineageTag: c13ac924-6319-4dff-ab95-68352ec386e2

	/// Revenue FC in EUR million for the UDF columns (forecast hatched where there are no actuals).
	measure 'Revenue FC mEUR' = DIVIDE ( [Revenue FC], 1000000 )
		formatString: #,##0.0
		displayFolder: Budapest demo\UDF
		lineageTag: d17f1585-7294-417e-a96a-834218d658f9

	/// Rung 3 with UDF library PowerofBI.IBCS 0.11.0 (daxlib.org, MIT): absolute variance as
	/// IBCS bar. Main value = |PL| + ΔPL, base = |PL|, so that the function draws exactly ΔPL (positive = good);
	/// scaling across all visible rows (both sort columns), total row in bold.
	measure 'ΔPL UDF' =
			IF (
			    ISBLANK ( [ΔPL] ),
			    BLANK (),
			    PowerofBI.IBCS.BarChart.AbsoluteVariance (
			        'dim-konten'[L1 EN],
			        ABS ( [PL signed] ) + [ΔPL],
			        BLANK (),
			        ABS ( [PL signed] ),
			        MAXX ( ALLSELECTED ( 'dim-konten'[L1 EN], 'dim-konten'[L1 Sort] ), ABS ( [ΔPL] ) ),
			        "outlined",
			        NOT ISINSCOPE ( 'dim-konten'[L1 EN] ),
			        FORMAT ( [ΔPL], "+#,##0.0;-#,##0.0;=", "en-US" ),
			        240,
			        22,
			        1
			    )
			)
		displayFolder: Budapest demo\UDF
		lineageTag: b0de9ae6-e37d-462a-81a6-de84a9e71452
		dataCategory: ImageUrl

	/// Rung 3 with UDF library PowerofBI.IBCS: relative variance as a pin with scenario head.
	/// Same convention as ΔPL UDF (base = |PL|), label from ΔPL %.
	measure 'ΔPL % UDF' =
			IF (
			    ISBLANK ( [ΔPL] ),
			    BLANK (),
			    PowerofBI.IBCS.BarChart.RelativeVariance (
			        'dim-konten'[L1 EN],
			        ABS ( [PL signed] ) + [ΔPL],
			        BLANK (),
			        ABS ( [PL signed] ),
			        "outlined",
			        NOT ISINSCOPE ( 'dim-konten'[L1 EN] ),
			        FORMAT ( [ΔPL %] * 100, "+#,##0.0;-#,##0.0;=", "en-US" ),
			        160,
			        22,
			        1
			    )
			)
		displayFolder: Budapest demo\UDF
		lineageTag: 8b8351b2-41c3-4f85-b5a6-dfe4f7871096
		dataCategory: ImageUrl

	/// Rung 3 with UDF library PowerofBI.IBCS: one column per month (matrix with months in the
	/// columns): AC filled, PL outline, PY as grey triangle, variance AC vs PL as bar, FC
	/// hatched. One function call instead of 30 lines of SVG DAX.
	measure 'Revenue months UDF' =
			IF (
			    ISBLANK ( [Revenue AC mEUR] + [Revenue FC mEUR] ),
			    BLANK (),
			    PowerofBI.IBCS.ColumnChart.WithAbsoluteVariance (
			        [Revenue AC mEUR],
			        [Revenue PY mEUR],
			        [Revenue PL mEUR],
			        [Revenue FC mEUR],
			        'dim-datum'[Month Short],
			        1
			    )
			)
		displayFolder: Budapest demo\UDF
		lineageTag: f91ff105-249c-4ec8-b56b-bfdac041ce3b
		dataCategory: ImageUrl

	/// v3 month-end close scene: TRUE when the switch 'close-status' is set to exactly "Incl. day-3 adjustment".
	/// With no selection or with "Closed WD3" FALSE, and AC stays exactly as before.
	measure 'Adjustment on' = SELECTEDVALUE ( 'close-status'[Close status] ) = "Incl. day-3 adjustment"
		displayFolder: Budapest demo\Close
		lineageTag: 3484290e-7e30-40e9-a686-bfddb609a0d7

	/// Helper measure: late posting in EUR (base units, raw sign), only when the switch is on. A filter
	/// on fact-abschluss[Monat] (period role of the P&L visual) is passed on via TREATAS.
	measure 'AC adjustment' =
			IF (
			    [Adjustment on],
			    CALCULATE (
			        SUM ( 'fact-nachbuchung'[AC Wert] ),
			        TREATAS ( VALUES ( 'fact-abschluss'[Monat] ), 'fact-nachbuchung'[Monat] )
			    )
			)
		formatString: #,##0
		isHidden
		displayFolder: Budapest demo\Close
		lineageTag: 87627ac9-f6ef-455f-8c5d-7fe99cb1a7cd

	/// Helper measure: late posting in local currency, only when the switch is on. Like AC adjustment.
	measure 'AC LW adjustment' =
			IF (
			    [Adjustment on],
			    CALCULATE (
			        SUM ( 'fact-nachbuchung'[AC LW Wert] ),
			        TREATAS ( VALUES ( 'fact-abschluss'[Monat] ), 'fact-nachbuchung'[Monat] )
			    )
			)
		formatString: #,##0
		isHidden
		displayFolder: Budapest demo\Close
		lineageTag: 16841457-1387-48db-9023-2a811791251b

	/// v3 FX: actual (income statement, sign-correct, EUR million) translated from local currency at the budget rate:
	/// LC / 'fact-kurse'[Kurs Budget] per company currency and year (rates are LC per 1 EUR, as in
	/// engine.py). Robust against multiple currencies and years in the filter. Includes the late posting when the switch is on.
	measure 'AC signed @BUD' =
			CALCULATE (
			    SUMX (
			        SUMMARIZE ( 'fact-abschluss', 'dim-gesellschaft'[Währung], 'dim-datum'[Jahr] ),
			        VAR _Cur = 'dim-gesellschaft'[Währung]
			        VAR _Yr = 'dim-datum'[Jahr]
			        VAR _Rate =
			            CALCULATE (
			                MAX ( 'fact-kurse'[Kurs Budget] ),
			                REMOVEFILTERS ( 'dim-datum' ),
			                REMOVEFILTERS ( 'dim-waehrung' ),
			                REMOVEFILTERS ( 'fact-kurse' ),
			                'fact-kurse'[Währung] = _Cur,
			                'fact-kurse'[Jahr] = _Yr
			            )
			        VAR _Lw =
			            CALCULATE (
			                SUMX (
			                    VALUES ( 'dim-konten'[SignConvention] ),
			                    'dim-konten'[SignConvention] * CALCULATE ( SUM ( 'fact-abschluss'[AC LW Wert] ) + [AC LW adjustment] )
			                )
			            )
			        RETURN
			            DIVIDE ( _Lw, _Rate )
			    ) / 1000000,
			    KEEPFILTERS ( 'dim-konten'[RowType] = "account" ),
			    KEEPFILTERS ( 'dim-konten'[Statement] = "Income statement" )
			)
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\FX
		lineageTag: e53d643b-c259-4274-9148-088569f2162c

	/// v3 FX: plan (income statement, sign-correct, EUR million) from the plan local currency at the budget rate. The plan
	/// in EUR (PL signed) is translated at the actual average rate in the demo; only this version is a
	/// plan at budget rate.
	measure 'PL signed @BUD' =
			CALCULATE (
			    SUMX (
			        SUMMARIZE ( 'fact-abschluss', 'dim-gesellschaft'[Währung], 'dim-datum'[Jahr] ),
			        VAR _Cur = 'dim-gesellschaft'[Währung]
			        VAR _Yr = 'dim-datum'[Jahr]
			        VAR _Rate =
			            CALCULATE (
			                MAX ( 'fact-kurse'[Kurs Budget] ),
			                REMOVEFILTERS ( 'dim-datum' ),
			                REMOVEFILTERS ( 'dim-waehrung' ),
			                REMOVEFILTERS ( 'fact-kurse' ),
			                'fact-kurse'[Währung] = _Cur,
			                'fact-kurse'[Jahr] = _Yr
			            )
			        VAR _Lw =
			            CALCULATE (
			                SUMX (
			                    VALUES ( 'dim-konten'[SignConvention] ),
			                    'dim-konten'[SignConvention] * CALCULATE ( SUM ( 'fact-abschluss'[PL LW Wert] ) )
			                )
			            )
			        RETURN
			            DIVIDE ( _Lw, _Rate )
			    ) / 1000000,
			    KEEPFILTERS ( 'dim-konten'[RowType] = "account" ),
			    KEEPFILTERS ( 'dim-konten'[Statement] = "Income statement" )
			)
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\FX
		lineageTag: 271369a3-4f23-4b07-8f76-05284075dd5e

	/// v3 FX: currency effect = actual at actual rate minus actual at budget rate. Positive = the euro was
	/// weaker than budgeted, foreign-currency results count for more in EUR.
	measure 'FX effect' =
			VAR _Ac = [AC signed]
			RETURN
			    IF ( NOT ISBLANK ( _Ac ), _Ac - [AC signed @BUD] )
		formatString: +#,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\FX
		lineageTag: 635c969b-cbbf-40fc-9528-7c466f4559cd

	/// v3 FX: operational variance excluding currency effects: actual at budget rate minus plan at budget rate,
	/// plan only for actual months (as ΔPL). Positive is good.
	measure 'ΔPL @BUD' =
			VAR _Ac = [AC signed @BUD]
			VAR _Pl = CALCULATE ( [PL signed @BUD], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) )
			RETURN
			    IF ( NOT ISBLANK ( _Ac ), _Ac - _Pl )
		formatString: +#,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\FX
		lineageTag: 0fc70b27-c39b-4153-9afc-3f9241f70b82

	/// v3 FX: net revenue actual at budget rate in EUR million.
	measure 'Revenue AC @BUD mEUR' = CALCULATE ( [AC signed @BUD], KEEPFILTERS ( 'dim-konten'[L1 EN] = "Net revenue" ) )
		formatString: #,##0.0
		displayFolder: Budapest demo\FX
		lineageTag: a593f014-a385-4538-ab25-3cec89fdf312

	/// v3 FX: currency effect on net revenue in EUR million (Revenue AC mEUR minus Revenue AC @BUD mEUR).
	measure 'Revenue FX effect mEUR' = CALCULATE ( [FX effect], KEEPFILTERS ( 'dim-konten'[L1 EN] = "Net revenue" ) )
		formatString: +#,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\FX
		lineageTag: bd463acc-5e51-4df5-90e4-7ea3cccc1e25

	/// v3 Statement: actual per row of the table pnl-lines (EUR million, sign-correct). "line" = AC signed
	/// of the L1 item, "subtotal" = sum of all L1 items with L1 Sort less than Upto Sort. BLANK without a
	/// unique row (total row), Net income is its own row.
	measure 'AC line' =
			VAR _Type = SELECTEDVALUE ( 'pnl-lines'[Line Type] )
			VAR _Line = SELECTEDVALUE ( 'pnl-lines'[Line] )
			VAR _Upto = SELECTEDVALUE ( 'pnl-lines'[Upto Sort] )
			RETURN
			    SWITCH (
			        _Type,
			        "line", CALCULATE ( [AC signed], KEEPFILTERS ( TREATAS ( { _Line }, 'dim-konten'[L1 EN] ) ) ),
			        "subtotal", CALCULATE ( [AC signed], KEEPFILTERS ( 'dim-konten'[L1 Sort] < _Upto ) )
			    )
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\Statement
		lineageTag: da2970c6-4724-42ed-8b17-0cfd17bc48f4

	/// v3 Statement: plan per row of pnl-lines, actual months only (Period Status = Actual), so that AC line,
	/// PL line and ΔPL line are comparable.
	measure 'PL line' =
			VAR _Type = SELECTEDVALUE ( 'pnl-lines'[Line Type] )
			VAR _Line = SELECTEDVALUE ( 'pnl-lines'[Line] )
			VAR _Upto = SELECTEDVALUE ( 'pnl-lines'[Upto Sort] )
			RETURN
			    SWITCH (
			        _Type,
			        "line", CALCULATE ( CALCULATE ( [PL signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) ), KEEPFILTERS ( TREATAS ( { _Line }, 'dim-konten'[L1 EN] ) ) ),
			        "subtotal", CALCULATE ( CALCULATE ( [PL signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) ), KEEPFILTERS ( 'dim-konten'[L1 Sort] < _Upto ) )
			    )
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\Statement
		lineageTag: 4fb7e2a6-699b-4c9d-ba3e-e72491fed227

	/// v3 Statement: previous year per row of pnl-lines, actual months only (Period Status = Actual).
	measure 'PY line' =
			VAR _Type = SELECTEDVALUE ( 'pnl-lines'[Line Type] )
			VAR _Line = SELECTEDVALUE ( 'pnl-lines'[Line] )
			VAR _Upto = SELECTEDVALUE ( 'pnl-lines'[Upto Sort] )
			RETURN
			    SWITCH (
			        _Type,
			        "line", CALCULATE ( CALCULATE ( [PY signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) ), KEEPFILTERS ( TREATAS ( { _Line }, 'dim-konten'[L1 EN] ) ) ),
			        "subtotal", CALCULATE ( CALCULATE ( [PY signed], KEEPFILTERS ( 'dim-datum'[Period Status] = "Actual" ) ), KEEPFILTERS ( 'dim-konten'[L1 Sort] < _Upto ) )
			    )
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\Statement
		lineageTag: 95179901-a5f8-498b-86b7-d66ba41e9148

	/// v3 Statement: variance actual vs plan per row of pnl-lines, positive is good.
	measure 'ΔPL line' =
			VAR _Ac = [AC line]
			RETURN
			    IF ( NOT ISBLANK ( _Ac ), _Ac - [PL line] )
		formatString: +#,##0.0;-#,##0.0;-
		displayFolder: Budapest demo\Statement
		lineageTag: a2254b11-e5bf-463b-bfe5-017a9165649e

	/// v3 Statement: variance actual vs plan in percent of the plan per row of pnl-lines.
	measure 'ΔPL % line' = DIVIDE ( [ΔPL line], ABS ( [PL line] ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: Budapest demo\Statement
		lineageTag: 7f811aae-5d50-4d1a-82ce-fb6ef1c11f98

	/// v3 Statement: color code for conditional formatting per row of pnl-lines, teal favorable, red unfavorable.
	measure 'ΔPL line status' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [ΔPL line] ), BLANK (),
			    [ΔPL line] >= 0, "#2E8B7A",
			    "#C0392B"
			)
		displayFolder: Budapest demo\Statement
		lineageTag: 4e19db1b-754b-45e7-9c7e-186a11bf6e53

	/// v3b rung 2, DAX only: variance bar made of Unicode blocks per row of pnl-lines, scaled to the
	/// largest ΔPL line of the visible rows (Line and Line Sort in ALLSELECTED). Negative left, positive right;
	/// fill character UNICHAR(160), because the matrix strips normal leading spaces.
	measure 'ΔPL line bar (text)' =
			VAR _D = [ΔPL line]
			VAR _Max =
			    MAXX ( ALLSELECTED ( 'pnl-lines'[Line], 'pnl-lines'[Line Sort] ), ABS ( [ΔPL line] ) )
			VAR _N = MIN ( 10, ROUND ( DIVIDE ( ABS ( _D ), _Max, 0 ) * 10, 0 ) )
			VAR _Neg = REPT ( UNICHAR ( 160 ), 10 - _N ) & REPT ( "█", _N )
			VAR _Pos = REPT ( "█", _N ) & REPT ( UNICHAR ( 160 ), 10 - _N )
			RETURN
			    IF (
			        ISBLANK ( _D ),
			        BLANK (),
			        IF ( _D < 0, _Neg & "│" & REPT ( UNICHAR ( 160 ), 10 ), REPT ( UNICHAR ( 160 ), 10 ) & "│" & _Pos )
			    )
		displayFolder: Budapest demo\Statement
		lineageTag: 6caec63f-518b-4bf9-8028-8bcfb41f8c79

	/// v3b rung 3, SVG measure per row of pnl-lines: variance bar with double line as plan reference,
	/// teal good, red bad, label in bold for subtotals. Data category ImageUrl.
	measure 'ΔPL line SVG' =
			VAR _D = [ΔPL line]
			VAR _Max =
			    MAXX ( ALLSELECTED ( 'pnl-lines'[Line], 'pnl-lines'[Line Sort] ), ABS ( [ΔPL line] ) )
			VAR _W = 160
			VAR _H = 18
			VAR _Mid = _W / 2
			VAR _Len = MIN ( 1, DIVIDE ( ABS ( _D ), _Max, 0 ) ) * ( _Mid - 44 )
			VAR _X = IF ( _D < 0, _Mid - _Len, _Mid )
			VAR _Col = IF ( _D >= 0, "%232E8B7A", "%23C0392B" )
			VAR _Lbl = FORMAT ( _D, "+#,##0.0;-#,##0.0", "en-US" )
			VAR _LblX = IF ( _D < 0, _Mid + 5, _Mid - 5 )
			VAR _Anchor = IF ( _D < 0, "start", "end" )
			VAR _Weight = IF ( SELECTEDVALUE ( 'pnl-lines'[Line Type] ) = "subtotal", "bold", "normal" )
			VAR _Svg =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "' viewBox='0 0 " & _W & " " & _H & "'>"
			        & "<line x1='" & ( _Mid - 1.5 ) & "' y1='0' x2='" & ( _Mid - 1.5 ) & "' y2='" & _H & "' stroke='%23404040' stroke-width='1'/>"
			        & "<line x1='" & ( _Mid + 1.5 ) & "' y1='0' x2='" & ( _Mid + 1.5 ) & "' y2='" & _H & "' stroke='%23404040' stroke-width='1'/>"
			        & "<rect x='" & FORMAT ( _X, "0.0", "en-US" ) & "' y='3' width='" & FORMAT ( _Len, "0.0", "en-US" ) & "' height='" & ( _H - 6 ) & "' fill='" & _Col & "'/>"
			        & "<text x='" & _LblX & "' y='13' font-family='Segoe UI' font-size='10' font-weight='" & _Weight & "' text-anchor='" & _Anchor & "' fill='%23222'>" & _Lbl & "</text>"
			        & "</svg>"
			RETURN
			    IF ( ISBLANK ( _D ), BLANK (), _Svg )
		displayFolder: Budapest demo\Statement
		lineageTag: 55d8ea23-b111-463a-93bc-48ef3421ae5e
		dataCategory: ImageUrl

	/// v3b rung 3 with UDF library PowerofBI.IBCS per row of pnl-lines: absolute variance as IBCS bar,
	/// main value = |PL line| + ΔPL line, base = |PL line|, scaling across Line and Line Sort, subtotals in bold.
	measure 'ΔPL line UDF' =
			IF (
			    ISBLANK ( [ΔPL line] ),
			    BLANK (),
			    PowerofBI.IBCS.BarChart.AbsoluteVariance (
			        'pnl-lines'[Line],
			        ABS ( [PL line] ) + [ΔPL line],
			        BLANK (),
			        ABS ( [PL line] ),
			        MAXX ( ALLSELECTED ( 'pnl-lines'[Line], 'pnl-lines'[Line Sort] ), ABS ( [ΔPL line] ) ),
			        "outlined",
			        SELECTEDVALUE ( 'pnl-lines'[Line Type] ) = "subtotal",
			        FORMAT ( [ΔPL line], "+#,##0.0;-#,##0.0;=", "en-US" ),
			        240,
			        22,
			        1
			    )
			)
		displayFolder: Budapest demo\Statement
		lineageTag: ce5278ad-463a-4510-8b10-6ed27caa3251
		dataCategory: ImageUrl

	/// v3b rung 3 with UDF library PowerofBI.IBCS per row of pnl-lines: relative variance as a pin,
	/// same convention as ΔPL line UDF, label from ΔPL % line, subtotals in bold.
	measure 'ΔPL % line UDF' =
			IF (
			    ISBLANK ( [ΔPL line] ),
			    BLANK (),
			    PowerofBI.IBCS.BarChart.RelativeVariance (
			        'pnl-lines'[Line],
			        ABS ( [PL line] ) + [ΔPL line],
			        BLANK (),
			        ABS ( [PL line] ),
			        "outlined",
			        SELECTEDVALUE ( 'pnl-lines'[Line Type] ) = "subtotal",
			        FORMAT ( [ΔPL % line] * 100, "+#,##0.0;-#,##0.0;=", "en-US" ),
			        160,
			        22,
			        1
			    )
			)
		displayFolder: Budapest demo\Statement
		lineageTag: 8142bc95-6791-454d-bd73-70be5dcd1f67
		dataCategory: ImageUrl

	/// Mean of the average rates of the selected months, units of
	/// local currency per 1 EUR. For income statement items and cash flows.
	measure Durchschnittskurs = AVERAGE ( 'fact-kurse'[Kurs Durchschnitt] )
		formatString: #,##0.0000
		displayFolder: Kurse
		lineageTag: 815597d5-b796-4fbd-8ffe-381193930661

	/// Rate on the last day of the selection, units of local currency per 1
	/// EUR. For balance sheet items.
	measure Stichtagskurs = LASTNONBLANKVALUE ( 'dim-datum'[Datum], MAX ( 'fact-kurse'[Kurs Stichtag] ) )
		formatString: #,##0.0000
		displayFolder: Kurse
		lineageTag: 59fce8a2-fc20-4017-8f8e-1de10ab37cd6

	/// Scenarios pages: revenue variance AC minus PL in EUR m, positive is favourable.
	/// Blank when AC or PL is blank.
	measure 'Rev ΔPL mEUR' =
			VAR _Ac = [Revenue AC mEUR]
			VAR _Pl = [Revenue PL mEUR]
			RETURN
			    IF ( NOT ISBLANK ( _Ac ) && NOT ISBLANK ( _Pl ), _Ac - _Pl )
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: Budapest demo\Scenarios
		lineageTag: cddd3ff4-37c8-4f6b-a4f1-aa563736c0af

	/// Scenarios pages: revenue variance AC minus PY in EUR m, positive is favourable.
	/// Blank when AC or PY is blank (Digital JP has no previous year).
	measure 'Rev ΔPY mEUR' =
			VAR _Ac = [Revenue AC mEUR]
			VAR _Py = [Revenue PY mEUR]
			RETURN
			    IF ( NOT ISBLANK ( _Ac ) && NOT ISBLANK ( _Py ), _Ac - _Py )
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: Budapest demo\Scenarios
		lineageTag: 2d03a854-48f2-44f5-a650-184302d2de96

	/// Scenarios pages: revenue variance AC vs PL in percent of PL.
	measure 'Rev ΔPL %' = DIVIDE ( [Rev ΔPL mEUR], ABS ( [Revenue PL mEUR] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Budapest demo\Scenarios
		lineageTag: 005e0153-21a4-4d81-81c8-59802a7c2163

	/// Scenarios pages: revenue variance AC vs PY in percent of PY.
	measure 'Rev ΔPY %' = DIVIDE ( [Rev ΔPY mEUR], ABS ( [Revenue PY mEUR] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Budapest demo\Scenarios
		lineageTag: 3e95c889-9a63-40a5-aba5-9c5cfe962fbc

	/// Scenarios rung 2, DAX only: ΔPL revenue variance as a Unicode block bar, scaled to the largest
	/// variance of the visible months or companies (both sort columns in ALLSELECTED). Needs a monospace font.
	measure 'Rev ΔPL bar (text)' =
			VAR _D = [Rev ΔPL mEUR]
			VAR _Max =
			    SWITCH (
			        TRUE (),
			        ISINSCOPE ( 'dim-datum'[Month Short] ),
			            MAXX ( ALLSELECTED ( 'dim-datum'[Month Short], 'dim-datum'[MonatNr] ), ABS ( [Rev ΔPL mEUR] ) ),
			        ISINSCOPE ( 'dim-gesellschaft'[Short name] ),
			            MAXX ( ALLSELECTED ( 'dim-gesellschaft'[Short name], 'dim-gesellschaft'[Sortierung] ), ABS ( [Rev ΔPL mEUR] ) ),
			        ABS ( _D )
			    )
			VAR _N = MIN ( 10, ROUND ( DIVIDE ( ABS ( _D ), _Max, 0 ) * 10, 0 ) )
			VAR _Neg = REPT ( " ", 10 - _N ) & REPT ( "█", _N )
			VAR _Pos = REPT ( "█", _N ) & REPT ( " ", 10 - _N )
			RETURN
			    IF (
			        ISBLANK ( _D ),
			        BLANK (),
			        IF ( _D < 0, _Neg & "│" & REPT ( " ", 10 ), REPT ( " ", 10 ) & "│" & _Pos )
			    )
		displayFolder: Budapest demo\Scenarios
		lineageTag: f0de6061-6039-46e7-a719-41f5c563303f

	/// Scenarios rung 2, DAX only: ΔPY revenue variance as a Unicode block bar, same scaling rule as ΔPL.
	measure 'Rev ΔPY bar (text)' =
			VAR _D = [Rev ΔPY mEUR]
			VAR _Max =
			    SWITCH (
			        TRUE (),
			        ISINSCOPE ( 'dim-datum'[Month Short] ),
			            MAXX ( ALLSELECTED ( 'dim-datum'[Month Short], 'dim-datum'[MonatNr] ), ABS ( [Rev ΔPY mEUR] ) ),
			        ISINSCOPE ( 'dim-gesellschaft'[Short name] ),
			            MAXX ( ALLSELECTED ( 'dim-gesellschaft'[Short name], 'dim-gesellschaft'[Sortierung] ), ABS ( [Rev ΔPY mEUR] ) ),
			        ABS ( _D )
			    )
			VAR _N = MIN ( 10, ROUND ( DIVIDE ( ABS ( _D ), _Max, 0 ) * 10, 0 ) )
			VAR _Neg = REPT ( " ", 10 - _N ) & REPT ( "█", _N )
			VAR _Pos = REPT ( "█", _N ) & REPT ( " ", 10 - _N )
			RETURN
			    IF (
			        ISBLANK ( _D ),
			        BLANK (),
			        IF ( _D < 0, _Neg & "│" & REPT ( " ", 10 ), REPT ( " ", 10 ) & "│" & _Pos )
			    )
		displayFolder: Budapest demo\Scenarios
		lineageTag: 5a7994c5-9119-44ba-a99c-7942af84f654

	/// Scenarios: colour code for conditional formatting by ΔPL sign, teal favourable, red unfavourable.
	measure 'Rev ΔPL color' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Rev ΔPL mEUR] ), BLANK (),
			    [Rev ΔPL mEUR] >= 0, "#2E8B7A",
			    "#C0392B"
			)
		displayFolder: Budapest demo\Scenarios
		lineageTag: ab6fc40f-1092-4438-b8bb-f1569ea34c3b

	/// Scenarios: colour code for conditional formatting by ΔPY sign, teal favourable, red unfavourable.
	measure 'Rev ΔPY color' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Rev ΔPY mEUR] ), BLANK (),
			    [Rev ΔPY mEUR] >= 0, "#2E8B7A",
			    "#C0392B"
			)
		displayFolder: Budapest demo\Scenarios
